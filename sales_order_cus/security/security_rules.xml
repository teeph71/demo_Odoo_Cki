<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ghi đè các quy tắc bản ghi (Record Rules) chuẩn của Odoo để áp dụng phân quyền theo khách hàng phụ trách -->
    <record id="sale.sale_order_personal_rule" model="ir.rule">
        <field name="domain_force">['|', ('partner_id.user_id', '=', user.id), ('partner_id.user_id', '=', False)]</field>
    </record>

    <record id="sale.sale_order_line_personal_rule" model="ir.rule">
        <field name="domain_force">['|', ('order_id.partner_id.user_id', '=', user.id), ('order_id.partner_id.user_id', '=', False)]</field>
    </record>
</odoo>
