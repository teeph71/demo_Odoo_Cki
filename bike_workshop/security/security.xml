<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bike_workshop" model="ir.module.category">
        <field name="name">Bike Workshop</field>
        <field name="description">Helps you manage your bike assembly process.</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_bike_workshop" model="res.groups.privilege">
        <field name="name">Bike Workshop Role</field>
        <field name="category_id" ref="module_category_bike_workshop"/>
    </record>

    <record id="group_workshop_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="privilege_id" ref="privilege_bike_workshop"/>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_bike_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_workshop_technician'))]"/>
    </record>
</odoo>
