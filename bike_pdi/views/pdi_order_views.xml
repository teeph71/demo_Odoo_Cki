<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bike_pdi_order_form" model="ir.ui.view">
        <field name="name">bike.pdi.order.form</field>
        <field name="model">bike.pdi.order</field>
        <field name="arch" type="xml">
            <form string="Bike PDI Order">
                <header>
                    <button name="action_start_inspection" string="Start Inspection" type="object" 
                            class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_set_pdi_pass" string="Pass" type="object" 
                            class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_set_pdi_fail" string="Fail" type="object" 
                            class="btn-danger" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,passed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sales_order_id"/>
                            <field name="customer_id"/>
                            <field name="result" invisible="not result"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="serial_id"/>
                            <field name="technician_id"/>
                        </group>
                    </group>
                    <group string="Failure Diagnosis" invisible="state not in ('in_progress', 'failed')">
                        <field name="fail_reason" placeholder="Mô tả chi tiết các hạng mục lỗi kỹ thuật phát sinh tại đây (Bắt buộc)..."/>
                    </group>
                    <notebook>
                        <page string="Inspection Checklist" name="checklist">
                            <field name="checklist_line_ids">
                                <list editable="bottom">
                                    <field name="item_name" readonly="1"/>
                                    <field name="status"/>
                                    <field name="note" placeholder="Nhập ghi chú đo đạc kỹ thuật..."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_bike_pdi_order_list" model="ir.ui.view">
        <field name="name">bike.pdi.order.list</field>
        <field name="model">bike.pdi.order</field>
        <field name="arch" type="xml">
            <list string="PDI Orders">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="serial_id"/>
                <field name="technician_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'pending'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'passed'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_bike_pdi_order_kanban" model="ir.ui.view">
        <field name="name">bike.pdi.order.kanban</field>
        <field name="model">bike.pdi.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="false">
                <field name="name"/>
                <field name="product_id"/>
                <field name="technician_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="product_id"/></div>
                                <div><field name="serial_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="technician_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pdi_queue" model="ir.actions.act_window">
        <field name="name">PDI Queue</field>
        <field name="res_model">bike.pdi.order</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_bike_pdi_queue" name="PDI Queue" parent="menu_bike_pdi_root" action="action_pdi_queue" sequence="10"/>
</odoo>
