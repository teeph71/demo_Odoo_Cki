<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="bike_pdi_order_technician_rule" model="ir.rule">
            <field name="name">Quality Inspector: Only View and Edit Assigned PDI Records</field>
            <field name="model_id" ref="model_bike_pdi_order"/>
            <field name="groups" eval="[(4, ref('bike_assembly.group_workshop_technician'))]"/>
            <field name="domain_force">['|', ('technician_id', '=', user.id), ('technician_id', '=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="bike_pdi_order_manager_rule" model="ir.rule">
            <field name="name">Manager: Full Access PDI Records</field>
            <field name="model_id" ref="model_bike_pdi_order"/>
            <field name="groups" eval="[(4, ref('bike_assembly.group_workshop_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
