<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_assembly_order_form" model="ir.ui.view">
        <field name="name">bike.assembly.order.form</field>
        <field name="model">bike.assembly.order</field>
        <field name="arch" type="xml">
            <form string="Assembly Order">
                <header>
                    <button name="action_assign" string="Assign" type="object" invisible="state != 'draft'" class="oe_highlight" groups="bike_assembly.group_workshop_manager"/>
                    <button name="action_start_assembly" string="Start Assembly" type="object" invisible="state != 'assigned'" class="oe_highlight"/>
                    <button name="action_complete_assembly" string="Complete Assembly" type="object" invisible="state not in ('in_progress', 'rework')" class="oe_highlight"/>
                    <button name="action_return_rework" string="Return to Rework" type="object" invisible="state != 'completed'" groups="bike_assembly.group_workshop_manager"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="picking_id"/>
                            <field name="sales_order_id"/>
                            <field name="customer_id"/>
                            <field name="product_id"/>
                            <field name="serial_id"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="checklist_template_id"/>
                            <field name="start_time"/>
                            <field name="finish_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_line_ids" readonly="state != 'in_progress'">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="completed" widget="boolean_toggle" readonly="parent.state != 'in_progress'"/>
                                    <field name="task_name" readonly="1"/>
                                    <field name="notes"/>
                                    <field name="completed_by" readonly="1" force_save="1"/>
                                    <field name="completed_at" readonly="1" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes or issues..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_assembly_order_tree" model="ir.ui.view">
        <field name="name">bike.assembly.order.tree</field>
        <field name="model">bike.assembly.order</field>
        <field name="arch" type="xml">
            <list string="Assembly Orders">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="serial_id"/>
                <field name="technician_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'assigned'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'rework'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_assembly_order_kanban" model="ir.ui.view">
        <field name="name">bike.assembly.order.kanban</field>
        <field name="model">bike.assembly.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="false">
                <field name="name"/>
                <field name="product_id"/>
                <field name="technician_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="product_id"/></div>
                                <div><field name="serial_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="technician_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_assembly_order" model="ir.actions.act_window">
        <field name="name">Assembly Queue</field>
        <field name="res_model">bike.assembly.order</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_my_assembly_order" model="ir.actions.act_window">
        <field name="name">My Assembly</field>
        <field name="res_model">bike.assembly.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('technician_id', '=', uid)]</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_bike_workshop_root" name="Bike Workshop" web_icon="bike_assembly,static/description/icon.png" sequence="30"/>
    
    <menuitem id="menu_bike_assembly_queue" name="Assembly Queue" parent="menu_bike_workshop_root" action="action_assembly_order" sequence="10"/>
    <menuitem id="menu_bike_my_assembly" name="My Assembly" parent="menu_bike_workshop_root" action="action_my_assembly_order" sequence="20"/>

    <menuitem id="menu_bike_workshop_config" name="Configuration" parent="menu_bike_workshop_root" sequence="100"/>
    <menuitem id="menu_bike_assembly_template" name="Assembly Checklist" parent="menu_bike_workshop_config" action="action_assembly_template" sequence="10"/>

</odoo>
