<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_bike_packing_order_form" model="ir.ui.view">
            <field name="name">bike.packing.order.form</field>
            <field name="model">bike.packing.order</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start_packing" string="Start Packing" type="object" class="oe_highlight" invisible="state not in ('pending', 'waiting_item')"/>
                        <button name="action_complete_packing" string="Complete Packing" type="object" class="oe_highlight" invisible="state != 'packing'"/>
                        <button name="action_waiting_item" string="Waiting Item" type="object" invisible="state != 'packing'"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,packing,packed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="picking_id" domain="[('picking_type_id.code', '=', 'outgoing')]"/>
                                <field name="sales_order_id"/>
                                <field name="customer_id"/>
                                <field name="product_id"/>
                                <field name="serial_id"/>
                            </group>
                            <group>
                                <field name="warehouse_user_id"/>
                                <field name="start_time"/>
                                <field name="packed_time"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Checklist" name="checklist">
                                <field name="checklist_line_ids">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="checked"/>
                                        <field name="item_name" readonly="1"/>
                                        <field name="note"/>
                                        <field name="checked_by"/>
                                        <field name="checked_at"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_bike_packing_order_list" model="ir.ui.view">
            <field name="name">bike.packing.order.list</field>
            <field name="model">bike.packing.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="sales_order_id"/>
                    <field name="customer_id"/>
                    <field name="product_id"/>
                    <field name="serial_id"/>
                    <field name="state" widget="badge" 
                           decoration-info="state == 'pending'"
                           decoration-warning="state == 'packing' or state == 'waiting_item'"
                           decoration-success="state == 'packed'"/>
                </list>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_bike_packing_queue" model="ir.actions.act_window">
            <field name="name">Packing Queue</field>
            <field name="res_model">bike.packing.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', 'in', ('pending', 'packing', 'waiting_item'))]</field>
        </record>

        <record id="action_bike_packing_my" model="ir.actions.act_window">
            <field name="name">My Packing</field>
            <field name="res_model">bike.packing.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('warehouse_user_id', '=', uid)]</field>
        </record>

        <record id="action_bike_packing_completed" model="ir.actions.act_window">
            <field name="name">Completed Packing</field>
            <field name="res_model">bike.packing.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'packed')]</field>
        </record>

        <!-- Menus -->
        <!-- Assume stock menu is already available, we just append to it -->
        <menuitem id="menu_bike_packing_root" name="Packing" parent="stock.menu_stock_root" sequence="6"/>
        
        <menuitem id="menu_bike_packing_queue" name="Packing Queue" parent="menu_bike_packing_root" action="action_bike_packing_queue" sequence="10"/>
        <menuitem id="menu_bike_packing_my" name="My Packing" parent="menu_bike_packing_root" action="action_bike_packing_my" sequence="20"/>
        <menuitem id="menu_bike_packing_completed" name="Completed Packing" parent="menu_bike_packing_root" action="action_bike_packing_completed" sequence="30"/>

    </data>
</odoo>
