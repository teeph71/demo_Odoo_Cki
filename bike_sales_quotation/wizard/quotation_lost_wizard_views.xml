<odoo>
    <!-- Quotation Lost Wizard Form -->
    <record id="view_quotation_lost_wizard_form" model="ir.ui.view">
        <field name="name">quotation.lost.wizard.form</field>
        <field name="model">quotation.lost.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Quotation Lost">
                <group>
                    <field name="action_type" widget="radio"/>
                </group>
                <group>
                    <group>
                        <field name="lost_reason_id" options="{'no_create': False, 'no_open': False}"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Note..."/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>