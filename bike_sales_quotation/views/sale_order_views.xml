<odoo>
    <data>
    <!-- Inherit Sale Order Form View  -->
        <record id="view_order_form_inherit_bike_complete" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.bike.complete</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- 1. Nút Lost -->
                <xpath expr="//header/button[@name='action_confirm']" position="after">
                    <button name="action_mark_lost" string="Lost" type="object" 
                            class="btn-secondary" 
                            invisible="state not in ['draft', 'sent'] or x_is_lost"/>
                </xpath>

                <!-- 2. Hiển thị Hạng khách hàng -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="x_is_member_display" invisible="1"/>
                    <label for="x_member_tier_id_display" string="Customer Tier" invisible="not partner_id"/>
                    <div class="o_row" invisible="not partner_id">
                        <field name="x_member_tier_id_display" readonly="1"/>
                        <span class="badge rounded-pill text-bg-info" invisible="not x_is_member_display">Member</span>
                    </div>
                </xpath>

                <!-- 3. Tab Lý do huỷ -->
                <xpath expr="//notebook" position="inside">
                <page string="Cancellation Information"
                    name="cancellation_information"
                    invisible="not x_is_lost">
                    <group>
                        <field name="x_lost_reason_id" readonly="1" options="{'no_open': True}"/>
                        <field name="x_lost_note" readonly="1"/>
                    </group>
                </page>
            </xpath>
            </field>
        </record>

        <!-- 4. Tree View -->
        <record id="view_quotation_tree_inherit_lost_info" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit.lost.info</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="x_lost_reason_id" optional="show" readonly="1" string="Lost Reason"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>