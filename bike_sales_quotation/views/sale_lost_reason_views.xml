<odoo>

    <record id="view_sale_lost_reason_search" model="ir.ui.view">
    <field name="name">sale.lost.reason.search</field>
    <field name="model">sale.lost.reason</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
        </search>
    </field>
    </record>

    <!-- List for Sale Lost Reason -->
    <record id="view_sale_lost_reason_list" model="ir.ui.view">
        <field name="name">sale.lost.reason.list</field>
        <field name="model">sale.lost.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Form View: Chia cột chuyên nghiệp -->
    <record id="view_sale_lost_reason_form" model="ir.ui.view">
        <field name="name">sale.lost.reason.form</field>
        <field name="model">sale.lost.reason</field>

        <field name="arch" type="xml">
            <form string="Lost Reason">
                <sheet>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <group>
                        <field name="name" placeholder="e.g., High Price"/>
                        <field name="active" invisible="1"/>
                        <field name="description" placeholder="e.g., The product is too expensive"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form for Sale Lost Reason -->
    <record id="action_sale_lost_reason" model="ir.actions.act_window">
        <field name="name">Lost Reasons</field>
        <field name="res_model">sale.lost.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu item for Sale Lost Reason -->
    <menuitem id="menu_sale_lost_reason" 
              action="action_sale_lost_reason" 
              parent="sale.menu_sale_config" 
              sequence="5"/>
</odoo>

