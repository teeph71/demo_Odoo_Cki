<odoo>
    <record id="view_partner_form_inherit_bicycle" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.bicycle</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Yêu cầu nhập số điện thoại -->
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <!-- Thêm nút Membership vào button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
            <button type="object"
                    class="oe_stat_button"
                    icon="fa-id-card-o">
                <field name="x_is_member" widget="boolean_toggle" class="o_stat_value"/>
                <div class="o_stat_info">
                    <span class="o_stat_text">Membership</span>
                </div>
            </button>
            </xpath>

            <!-- Thẻ Membership & Loyalty ở thanh tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Membership &amp; Loyalty" 
                      name="membership_loyalty" 
                      invisible="not x_is_member">
                    <group>
                        <group string="STATISTICS">
                            <field name="x_total_spent" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="x_loyalty_points"/>
                        </group>
                        <group string="RANKING">
                            <field name="x_member_tier_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    
    <!-- View adjusted danh sách tại list -->
    <record id="view_partner_list_inherit_bicycle" model="ir.ui.view">
    <field name="name">res.partner.list.inherit.bicycle</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//list" position="inside">
            <field name="x_member_tier_id" string="Membership Tier" optional="show"/>
            <field name="x_is_member" string="Is Member" optional="hide"/>
            <field name="x_loyalty_points" string="Loyalty Points" optional="hide"/>
        </xpath>
    </field>
</record>
</odoo>