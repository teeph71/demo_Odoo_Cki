<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_bike_warranty_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div style="text-align:center; margin-bottom: 24px;">
                                <h1 style="font-size:28px;font-weight:bold;color:#1a3c6e;
                                    letter-spacing:2px;border-bottom:3px solid #1a3c6e;
                                    padding-bottom:8px;display:inline-block;">
                                    PHIẾU BẢO HÀNH XE
                                </h1>
                                <p style="font-size:14px;color:#555;margin-top:4px;">
                                    Mã phiếu:
                                    <strong style="color:#1a3c6e;font-size:16px;">
                                        <t t-esc="o.name"/>
                                    </strong>
                                </p>
                            </div>

                            <!-- Thông tin sản phẩm -->
                            <div style="background:#f0f4ff;border-left:5px solid #1a3c6e;
                                padding:14px 18px;margin-bottom:18px;border-radius:4px;">
                                <h3 style="margin:0 0 10px 0;color:#1a3c6e;">🚲 Thông Tin Sản Phẩm</h3>
                                <table width="100%" style="font-size:13px;">
                                    <tr>
                                        <td width="35%" style="padding:5px 0;color:#666;">Sản phẩm:</td>
                                        <td style="padding:5px 0;font-weight:bold;">
                                            <t t-esc="o.product_id.display_name or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 0;color:#666;">Loại sản phẩm:</td>
                                        <td style="padding:5px 0;">
                                            <t t-esc="o.product_category_id.name or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 0;color:#666;">Đơn hàng:</td>
                                        <td style="padding:5px 0;">
                                            <t t-esc="o.sale_order_id.name or ''"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Thời gian bảo hành -->
                            <div style="background:#fff8e1;border-left:5px solid #f59e0b;
                                padding:14px 18px;margin-bottom:18px;border-radius:4px;">
                                <h3 style="margin:0 0 10px 0;color:#b45309;">📅 Thời Gian Bảo Hành</h3>
                                <table width="100%" style="font-size:13px;">
                                    <tr>
                                        <td width="35%" style="padding:5px 0;color:#666;">Thời hạn:</td>
                                        <td style="padding:5px 0;font-weight:bold;font-size:15px;color:#b45309;">
                                            <t t-esc="o.warranty_duration"/> tháng
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 0;color:#666;">Ngày bắt đầu:</td>
                                        <td style="padding:5px 0;">
                                            <t t-esc="o.start_date and o.start_date.strftime('%d/%m/%Y') or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 0;color:#666;">Ngày hết hạn:</td>
                                        <td style="padding:5px 0;font-weight:bold;color:#dc2626;">
                                            <t t-esc="o.end_date and o.end_date.strftime('%d/%m/%Y') or 'Không xác định'"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Thông tin khách hàng -->
                            <div style="background:#f0fdf4;border-left:5px solid #16a34a;
                                padding:14px 18px;margin-bottom:18px;border-radius:4px;">
                                <h3 style="margin:0 0 10px 0;color:#15803d;">👤 Thông Tin Khách Hàng</h3>
                                <table width="100%" style="font-size:13px;">
                                    <tr>
                                        <td width="35%" style="padding:5px 0;color:#666;">Họ và tên:</td>
                                        <td style="padding:5px 0;font-weight:bold;">
                                            <t t-esc="o.partner_name or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 0;color:#666;">Số điện thoại:</td>
                                        <td style="padding:5px 0;">
                                            <t t-esc="o.partner_phone or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 0;color:#666;">Địa chỉ:</td>
                                        <td style="padding:5px 0;">
                                            <t t-esc="o.partner_street or ''"/>
                                            <t t-if="o.partner_city">, <t t-esc="o.partner_city"/></t>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Ghi chú -->
                            <t t-if="o.note">
                                <div style="border:1px dashed #ccc;padding:12px 16px;
                                    margin-bottom:18px;border-radius:4px;">
                                    <strong>Ghi chú / Điều khoản bảo hành:</strong>
                                    <p style="margin-top:6px;color:#555;">
                                        <t t-esc="o.note"/>
                                    </p>
                                </div>
                            </t>

                            <!-- Chữ ký -->
                            <div style="margin-top:40px;">
                                <table width="100%">
                                    <tr>
                                        <td width="50%" style="text-align:center;padding:10px;">
                                            <p style="font-weight:bold;margin-bottom:60px;">Đại Diện Cửa Hàng</p>
                                            <p style="color:#999;font-size:12px;">(Ký, đóng dấu)</p>
                                        </td>
                                        <td width="50%" style="text-align:center;padding:10px;">
                                            <p style="font-weight:bold;margin-bottom:60px;">Khách Hàng</p>
                                            <p style="color:#999;font-size:12px;">(Ký và ghi rõ họ tên)</p>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div style="text-align:center;margin-top:30px;padding-top:10px;
                                border-top:1px solid #ddd;font-size:11px;color:#999;">
                                Phiếu bảo hành có giá trị khi có đầy đủ thông tin và chữ ký của hai bên.
                                Vui lòng giữ phiếu để xuất trình khi cần bảo hành.
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
