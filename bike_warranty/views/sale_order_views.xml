<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Smart Button + nút tạo phiếu BH trên Sale Order -->
        <record id="view_sale_order_warranty_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.warranty.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                        name="action_view_warranties"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shield"
                        invisible="warranty_count == 0"
                    >
                        <field
                            name="warranty_count"
                            widget="statinfo"
                            string="Phiếu BH"
                        />
                    </button>
                </xpath>

                <xpath expr="//button[@name='action_cancel']" position="before">
                    <button
                        name="action_create_warranty_from_so"
                        string="🛡️ Tạo Phiếu BH Thủ Công"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ['sale', 'done']"
                    />
                </xpath>

            </field>
        </record>

    </data>
</odoo>
