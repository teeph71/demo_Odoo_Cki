<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════
             ACTIONS
        ═══════════════════════════════════════════════════════ -->
        <record id="action_bike_warranty" model="ir.actions.act_window">
            <field name="name">Phiếu Bảo Hành</field>
            <field name="res_model">bike.warranty</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Chưa có phiếu bảo hành nào!
                </p>
                <p>Phiếu bảo hành sẽ tự động tạo khi xác nhận đơn hàng.</p>
            </field>
        </record>

        <record id="action_bike_warranty_active" model="ir.actions.act_window">
            <field name="name">Phiếu Đang Hiệu Lực</field>
            <field name="res_model">bike.warranty</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'active')]</field>
        </record>

        <record id="action_bike_warranty_expiring_soon" model="ir.actions.act_window">
            <field name="name">Sắp Hết Hạn (30 Ngày)</field>
            <field name="res_model">bike.warranty</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[
                ('state', '=', 'active'),
                ('end_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),
                ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))
            ]</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════
             LIST VIEW
        ═══════════════════════════════════════════════════════ -->
        <record id="view_bike_warranty_list" model="ir.ui.view">
            <field name="name">bike.warranty.list</field>
            <field name="model">bike.warranty</field>
            <field name="arch" type="xml">
                <list
                    string="Phiếu Bảo Hành"
                    decoration-success="state == 'active'"
                    decoration-warning="state == 'draft'"
                    decoration-danger="state == 'expired'"
                    decoration-muted="state == 'cancelled'"
                >
                    <field name="name"/>
                    <field name="sale_order_id"/>
                    <field name="partner_name"/>
                    <field name="partner_phone"/>
                    <field name="product_id"/>
                    <field name="product_category_id"/>
                    <field name="warranty_duration"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"
                        widget="badge"
                        decoration-success="state == 'active'"
                        decoration-warning="state == 'draft'"
                        decoration-danger="state == 'expired'"
                        decoration-muted="state == 'cancelled'"
                    />
                </list>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════
             FORM VIEW
        ═══════════════════════════════════════════════════════ -->
        <record id="view_bike_warranty_form" model="ir.ui.view">
            <field name="name">bike.warranty.form</field>
            <field name="model">bike.warranty</field>
            <field name="arch" type="xml">
                <form string="Phiếu Bảo Hành">
                    <header>
                        <button
                            name="action_activate"
                            string="Kích Hoạt"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                        />
                        <button
                            name="action_cancel"
                            string="Hủy Phiếu"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ['draft', 'active']"
                            confirm="Bạn có chắc muốn hủy phiếu bảo hành này không?"
                        />
                        <button
                            name="action_reset_draft"
                            string="Đặt Lại Nháp"
                            type="object"
                            invisible="state != 'cancelled'"
                        />
                        <button
                            name="action_print_warranty"
                            string="🖨️ In Phiếu BH"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"
                        />
                        <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,active,expired"
                        />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group col="2">
                            <group string="Thông Tin Phiếu Bảo Hành">
                                <field name="sale_order_id"/>
                                <field name="sale_order_line_id"
                                    invisible="not sale_order_id"
                                />
                                <field name="start_date" required="1"/>
                                <field name="end_date" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Thông Tin Sản Phẩm">
                                <field name="product_id" required="1"/>
                                <field name="product_category_id" readonly="1"/>
                                <field name="warranty_duration" required="1"/>
                            </group>
                        </group>
                        <group string="Thông Tin Khách Hàng">
                            <group>
                                <field name="partner_id" required="1"/>
                                <field name="partner_name"/>
                                <field name="partner_phone"/>
                            </group>
                            <group>
                                <field name="partner_street"/>
                                <field name="partner_city"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Ghi Chú">
                                <field
                                    name="note"
                                    placeholder="Nhập ghi chú hoặc điều kiện bảo hành..."
                                    nolabel="1"
                                />
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════
             SEARCH VIEW
        ═══════════════════════════════════════════════════════ -->
        <record id="view_bike_warranty_search" model="ir.ui.view">
            <field name="name">bike.warranty.search</field>
            <field name="model">bike.warranty</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm phiếu bảo hành">
                    <field name="name" string="Mã phiếu BH"/>
                    <field name="partner_name" string="Tên khách hàng"/>
                    <field name="partner_phone" string="Số điện thoại"/>
                    <field name="product_id" string="Sản phẩm"/>
                    <field name="sale_order_id" string="Đơn hàng"/>
                    <separator/>
                    <filter name="filter_active" string="Đang hiệu lực"
                        domain="[('state', '=', 'active')]"/>
                    <filter name="filter_expired" string="Hết hạn"
                        domain="[('state', '=', 'expired')]"/>
                    <filter name="filter_draft" string="Nháp"
                        domain="[('state', '=', 'draft')]"/>
                    <separator/>
                    <group>
                        <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                        <filter name="group_category" string="Loại sản phẩm"
                            context="{'group_by': 'product_category_id'}"/>
                        <filter name="group_start_month" string="Tháng bắt đầu BH"
                            context="{'group_by': 'start_date:month'}"/>
                        <filter name="group_partner" string="Khách hàng"
                            context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
