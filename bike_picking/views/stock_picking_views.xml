<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_bike_picking" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.bike.picking</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="is_bike_order" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_inherit_bike_picking" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.bike.picking</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="picking_status" widget="badge" decoration-info="picking_status == 'waiting_pick'" decoration-warning="picking_status == 'picking'" decoration-success="picking_status in ('picked', 'ready_pickup')"/>
                <field name="is_bike_order" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
