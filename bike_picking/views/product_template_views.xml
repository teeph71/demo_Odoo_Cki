<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_bike_picking" model="ir.ui.view">
        <field name="name">product.template.form.inherit.bike.picking</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <field name="is_bike"/>
                <field name="is_assembly_required" invisible="not is_bike"/>
            </xpath>
        </field>
    </record>
</odoo>
