<odoo>
<record id="view_order_form_inherit_bike_repair" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.bike.repair</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <div name="button_box" position="inside">
            <button name="action_view_repair_order" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not repair_order_id">
                <div class="o_stat_info">
                    <span class="o_stat_text">Repair Order</span>
                </div>
            </button>
        </div>
    </field>
</record>
</odoo>