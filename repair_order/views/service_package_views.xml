<odoo>
    <record id="view_bike_repair_service_package_list" model="ir.ui.view">
        <field name="name">bike.repair.service.package.list</field>
        <field name="model">bike.repair.service.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bike_repair_service_package_form" model="ir.ui.view">
        <field name="name">bike.repair.service.package.form</field>
        <field name="model">bike.repair.service.package</field>
        <field name="arch" type="xml">
            <form string="Repair Service Package">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="product_id" groups="base.group_no_one"/>
                        <field name="price"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="checklist_template_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bike_repair_service_package_action" model="ir.actions.act_window">
        <field name="name">Repair Service Packages</field>
        <field name="res_model">bike.repair.service.package</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create service packages for repair pricing.
            </p>
        </field>
    </record>

    <record id="view_bike_repair_checklist_template_list" model="ir.ui.view">
        <field name="name">bike.repair.checklist.template.list</field>
        <field name="model">bike.repair.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_bike_repair_checklist_template_form" model="ir.ui.view">
        <field name="name">bike.repair.checklist.template.form</field>
        <field name="model">bike.repair.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Repair Checklist Template">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="completed"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bike_repair_checklist_template_action" model="ir.actions.act_window">
        <field name="name">Repair Checklist Templates</field>
        <field name="res_model">bike.repair.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
